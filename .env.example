# MOIL SMARTMINE AI — Environment Configuration Example
# Copy this file to .env or .env.local for local testing.

# CARTO Basemaps API Key (Optional)
# If set, authenticated CARTO Dark Matter basemap tiles will be used.
# If omitted or empty, the application automatically uses a free dark OpenStreetMap fallback basemap.
VITE_CARTO_API_KEY=YOUR_CARTO_KEY
